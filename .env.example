# ── LOUP-GAROU DZ ─────────────────────────────────────────────
# Copy to .env and adjust. Never commit the real .env.

# HTTP port for the API + Socket.IO + production static client
PORT=4000

# Comma separated origins allowed to call the API / connect sockets.
# In development the Vite server (5173) is added automatically.
CLIENT_ORIGIN=http://localhost:5173

# JWT signing secret. MUST be a long random string in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# SQLite file path (relative to repository root)
DATABASE_PATH=data/loupgarou.db

# Comma separated usernames that are automatically promoted to admin
# when they register (the first one is also seeded).
ADMIN_USERNAMES=admin

# Optional: set to "true" to trust the first proxy (needed on Render/Heroku
# so rate limiting and secure cookies work behind a load balancer)
TRUST_PROXY=false

# Client build-time API base. Leave empty when client and server share an origin.
# VITE_API_URL=https://api.example.com

# Optional: Google OAuth 2.0 Web client.
# Add this exact URL as an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
